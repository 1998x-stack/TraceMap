# TraceMap local development stack as a systemd **USER** service.
#
# This file is a REVIEWABLE TEMPLATE and is NOT installed automatically.
# It is a development convenience only — it must never be used to expose the
# development authentication or a real user's data. See scripts/systemd/README.md.
#
# Replace __REPO__ with the absolute path of this repository, then install per
# the README. No system-level (root) unit is provided or required.

[Unit]
Description=TraceMap local development stack (loopback only, dev auth)
After=network.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=__REPO__
ExecStart=__REPO__/scripts/dev-start.sh
ExecStop=__REPO__/scripts/dev-stop.sh
TimeoutStartSec=90
TimeoutStopSec=30
# Default KillMode=control-group tears down any process still inside the
# service cgroup when the unit stops or the user session ends.

[Install]
WantedBy=default.target
