# TraceMap — local development configuration template.
#
#   cp .env.example .env && chmod 600 .env     # then edit .env
#
# `.env` is git-ignored: NEVER commit real secrets. Real environment variables
# always win over this file, and `TRACEMAP_DOTENV=0` disables it entirely (the
# hermetic test suite, the Playwright harness and the isolated smoke workflow do
# this so they never reach a real model).

# --- core ----------------------------------------------------------------
TRACEMAP_ENV=development
# PID / log / SQLite root (absolute; keep it OUTSIDE the repository).
TRACEMAP_RUNTIME_DIR=/home/you/tracemap-runtime
# Optional explicit absolute database URL. Leave unset to derive
#   $TRACEMAP_RUNTIME_DIR/data/tracemap-dev.db   (a relative path is rejected).
# TRACEMAP_DATABASE_URL=sqlite:////home/you/tracemap-runtime/data/tracemap-dev.db
# Seconds a SQLite connection waits for a lock before failing (GT-0020).
TRACEMAP_SQLITE_TIMEOUT=20

# --- bind addresses (loopback only; scripts fail closed otherwise) --------
TRACEMAP_API_HOST=127.0.0.1
TRACEMAP_API_PORT=8000
TRACEMAP_WEB_HOST=127.0.0.1
TRACEMAP_WEB_PORT=5173
# Vite dev proxy target for /api and /health; MUST be http://127.0.0.1:<port>.
TRACEMAP_PROXY_TARGET=http://127.0.0.1:8000

# --- isolated browser-test ports (optional) ------------------------------
# TRACEMAP_E2E_API_PORT=8010
# TRACEMAP_E2E_WEB_PORT=5273

# --- generation backend --------------------------------------------------
# `extractive` = deterministic offline demo (default). `llm` = real model.
TRACEMAP_GENERATION_MODE=extractive

# --- LLM provider (only read when TRACEMAP_GENERATION_MODE=llm) ----------
# Any OpenAI-compatible /chat/completions endpoint.
TRACEMAP_LLM_BASE_URL=https://iagent.iauto.com/v1
TRACEMAP_LLM_MODEL=iagent/standard
TRACEMAP_LLM_TIMEOUT=180
TRACEMAP_LLM_MAX_TOKENS=8192
# One bounded retry after finish_reason=length; default 2x output budget.
TRACEMAP_LLM_RETRY_MAX_TOKENS=16384
# Provide the key by pointing at a private key file (preferred, mode 600) ...
TRACEMAP_LLM_API_KEY_FILE=~/.config/ai-credentials/iauto_api_key
# ... or inline (keep it out of git):
# TRACEMAP_LLM_API_KEY=sk-replace-me

# PDF extraction runs in a spawned process; limits are enforced on Linux via POSIX rlimits.
TRACEMAP_PDF_TIMEOUT_SECONDS=15
TRACEMAP_PDF_CPU_SECONDS=10
TRACEMAP_PDF_MEMORY_MB=1024
